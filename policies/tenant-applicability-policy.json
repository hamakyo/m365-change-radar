{
  "policyId": "m365-tenant-applicability",
  "policyRulesVersion": "tenant-applicability-2026-11.2",
  "description": "Maps normalized Microsoft 365 workload and sovereign-cloud partition labels to inspectable tenant profile service and environment flags.",
  "rules": [
    {
      "ruleId": "sovereign-cloud-gcc-applicable",
      "enabled": true,
      "description": "US Government GCC-only changes apply only when environment.cloud_gcc is enabled.",
      "selector": {
        "field": "products",
        "values": ["Microsoft Cloud GCC"]
      },
      "condition": {
        "kind": "all_of",
        "conditions": [
          { "section": "environment", "key": "cloud_gcc", "equals": true }
        ]
      }
    },
    {
      "ruleId": "sovereign-cloud-gcc-high-applicable",
      "enabled": true,
      "description": "US Government GCC High-only changes apply only when environment.cloud_gcc_high is enabled.",
      "selector": {
        "field": "products",
        "values": ["Microsoft Cloud GCC High"]
      },
      "condition": {
        "kind": "all_of",
        "conditions": [
          { "section": "environment", "key": "cloud_gcc_high", "equals": true }
        ]
      }
    },
    {
      "ruleId": "sovereign-cloud-dod-applicable",
      "enabled": true,
      "description": "US Department of Defense (DoD)-only changes apply only when environment.cloud_dod is enabled.",
      "selector": {
        "field": "products",
        "values": ["Microsoft Cloud DoD"]
      },
      "condition": {
        "kind": "all_of",
        "conditions": [
          { "section": "environment", "key": "cloud_dod", "equals": true }
        ]
      }
    },
    {
      "ruleId": "sovereign-cloud-china-applicable",
      "enabled": true,
      "description": "Microsoft Cloud operated by 21Vianet (China)-only changes apply only when environment.cloud_china_21vianet is enabled.",
      "selector": {
        "field": "products",
        "values": ["Microsoft Cloud China (21Vianet)"]
      },
      "condition": {
        "kind": "all_of",
        "conditions": [
          {
            "section": "environment",
            "key": "cloud_china_21vianet",
            "equals": true
          }
        ]
      }
    },
    {
      "ruleId": "teams-applicable",
      "enabled": true,
      "description": "Microsoft Teams changes apply when services.teams is enabled.",
      "selector": {
        "field": "products",
        "values": ["Microsoft Teams"]
      },
      "condition": {
        "kind": "all_of",
        "conditions": [
          { "section": "services", "key": "teams", "equals": true }
        ]
      }
    },
    {
