{
  "policyId": "synthetic-tenant-applicability",
  "policyRulesVersion": "tenant-applicability-2026-08",
  "description": "Maps synthetic product labels to inspectable tenant services.",
  "rules": [
    {
      "ruleId": "synthetic-teams",
      "enabled": true,
      "selector": { "field": "products", "values": ["Synthetic Teams"] },
      "condition": {
        "kind": "all_of",
        "conditions": [
          { "section": "services", "key": "teams", "equals": true }
        ]
      }
    },
    {
      "ruleId": "synthetic-exchange",
      "enabled": true,
      "selector": { "field": "products", "values": ["Synthetic Exchange"] },
      "condition": {
        "kind": "all_of",
        "conditions": [
          {
            "section": "services",
            "key": "exchange_online",
            "equals": true
          }
        ]
      }
    },
    {
      "ruleId": "synthetic-sharepoint",
      "enabled": true,
      "selector": { "field": "products", "values": ["Synthetic SharePoint"] },
      "condition": {
        "kind": "all_of",
        "conditions": [
          {
            "section": "services",
            "key": "sharepoint_online",
            "equals": true
          }
        ]
      }
    },
    {
      "ruleId": "synthetic-intune",
      "enabled": true,
      "selector": { "field": "products", "values": ["Synthetic Intune"] },
